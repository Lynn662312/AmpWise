# Copy this file to .env and fill in the values.
# Variable names follow docs/api_contract.md section 7.

# 1 = every endpoint returns the contract's example responses
MOCK=1

# Folder holding the ML parquet files and params.json
DATA_DIR=../ml/outputs

# CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:5173

# AI advice (secret, never commit)
LLM_API_KEY=
LLM_MODEL=

# Firebase Admin SDK: path to, or JSON of, the service account (secret, never commit)
FIREBASE_CREDENTIALS=
