# Copy this file to .env and fill in the values.

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:5173

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Path to the service account key JSON (never commit the key file)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ML model
MODEL_PATH=../ml/models/exported/
MODEL_STORAGE_PATH=
