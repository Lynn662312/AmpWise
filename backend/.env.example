# Copy this file to .env and fill in the values.
# Variable names follow docs/api_contract.md section 7.
# Rule for this file: one variable per line. A value must never continue on the next line.

# 0 = serve ML's real converted data from DATA_DIR (use this for the demo)
# 1 = every endpoint returns the contract's example responses
MOCK=0

# Folder holding the converted ML files (written by scripts/convert_ml_outputs.py, committed to git)
DATA_DIR=./data

# CORS: the frontend addresses that may call this API, separated by commas, no spaces
CORS_ORIGINS=http://localhost:5173,https://ampwise.vercel.app

# AI advice (key is secret, never commit). Leave both empty to use template advice.
# The provider follows the model name, so switching is just changing these two lines:
#   claude-...  -> Anthropic key        gemini-...  -> Google AI Studio key
#   anything else (e.g. gpt-...) -> OpenAI key
LLM_API_KEY=
LLM_MODEL=

# Firebase Admin SDK service account (secret, never commit). Leave empty to run without Firestore:
# everything works except saving "assigned" / "done" on an action.
#
# Use ONE of the two forms below. Do not paste the downloaded JSON as it is: it has many lines,
# and then only the first line ("{") is read and the server stops at start-up.
#
# Form 1 (easiest): keep the downloaded file in this folder and give its path.
#   Use the file's own, exact name: Firebase adds letters and numbers to it.
#   Any file named *firebase-adminsdk*.json is already ignored by git.
# FIREBASE_CREDENTIALS=./your-project-firebase-adminsdk-xxxxx-0123456789.json
#
# Form 2: the whole JSON on one line, inside single quotes. Keep every \n inside private_key as it is.
# FIREBASE_CREDENTIALS='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}'
#
# On Render, paste the JSON as the value of FIREBASE_CREDENTIALS in the dashboard (many lines are fine there).
FIREBASE_CREDENTIALS=
