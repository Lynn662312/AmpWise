# Copy this file to .env and fill in the values.
# Only variables prefixed with VITE_ are exposed to the React app.
# On Vercel, set the same three variables in the project settings (this file is not uploaded).

# Backend API. Local backend: http://localhost:8000/api

VITE_API_BASE_URL=http://localhost:8000/api

# "api" = call the backend above (use this for the demo). "mock" = local sample files only.
VITE_DATA_MODE=api

# "true" shows assign / mark done. It needs PATCH /api/actions/{id}/status and
# FIREBASE_CREDENTIALS on the backend; otherwise keep "false".
VITE_ACTION_STATUS_ENABLED=true
