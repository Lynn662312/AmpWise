# Copy this file to .env and fill in the values.
# Only variables prefixed with VITE_ are exposed to the React app.

# Backend API
VITE_API_BASE_URL=http://localhost:8000/api

# Set to "api" to enable live What-if POST requests. Defaults to deterministic mock mode.
VITE_DATA_MODE=mock

# Set to "true" only when PATCH /api/actions/{id}/status is deployed.
VITE_ACTION_STATUS_ENABLED=false
